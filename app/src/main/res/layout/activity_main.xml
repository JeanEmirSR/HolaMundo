<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Titulo de la pantalla principal -->
    <TextView
        android:id="@+id/lblTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Integrantes del equipo"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="25dp" />

    <!-- Primer integrante -->
    <TextView
        android:id="@+id/txtIntegrante1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="SANCHEZ REYES JEAN EMIR" />

    <!-- Segundo integrante -->
    <TextView
        android:id="@+id/txtIntegrante2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="SANLUIS GONZALEZ JAHIR"
        android:layout_marginTop="15dp" />

    <!-- Boton que se programara en la practica B -->
    <Button
        android:id="@+id/btnMostrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mostrar"
        android:layout_marginTop="25dp" />

</LinearLayout>
